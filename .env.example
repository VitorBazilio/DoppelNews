# Copie para .env (local) ou cadastre como variáveis de ambiente na hospedagem.
# Sem DB_DSN o site usa SQLite local (storage/doppel.sqlite), criado automaticamente.
#DB_DSN=mysql:host=SEU_HOST;port=3306;dbname=doppel;charset=utf8mb4
#DB_USER=usuario
#DB_PASS=senha
# Caminho do bundle de CAs para TLS verificado (ex.: /etc/ssl/certs/ca-certificates.crt)
#DB_SSL_CA=
# Prefixo quando o site roda numa subpasta e a detecção automática não basta (ex.: /Doppel/public)
#APP_BASE=
APP_DEBUG=0
